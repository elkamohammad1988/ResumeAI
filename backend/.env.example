# ─── Required ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/resumeDB?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string

# Google Gemini (free tier: 1500 req/day)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Local dev: http://localhost:5173
# Production: your deployed frontend URL, e.g. https://resumeai.vercel.app
CLIENT_ORIGIN=http://localhost:5173,https://resumeai-seven-pi.vercel.app

# ─── Stripe (optional — payments disabled if missing) ──────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys (start with test mode)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — different per environment:
#   - Local dev: run `npm run stripe:listen` (root) — copy the whsec_ it prints
#   - Production: create a webhook at https://dashboard.stripe.com/webhooks
#     pointing at https://<your-backend>/api/billing/webhook
#     and copy the resulting whsec_
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from https://dashboard.stripe.com/products
# Create one product "Pro" with two prices (monthly $9, yearly $84/yr = $7/mo)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
