# ────────────────────────────────────────────────
# Supabase (https://supabase.com → New project → Settings → API)
# ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ────────────────────────────────────────────────
# Stripe (https://dashboard.stripe.com/test/apikeys)
# Optional — pricing page works without it; checkout buttons hidden when absent
# ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ────────────────────────────────────────────────
# AI provider — at least one is required for Generator
# Gemini default (free tier 1500/day): https://aistudio.google.com/apikey
# ────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
